permit (principal, action == Action::"sendMessage", resource is Message) when { principal is LicensedHealthCareProfessional && context.session.isActive && context.session has licensedHealthCareProfessional && context.session.licensedHealthCareProfessional == principal && resource.sender == principal && resource has patient && resource.patient == context.patient && principal in context.patient.designatedLHCPs && (resource.recipient == context.patient || resource.recipient in context.patient.personalRepresentatives) };
permit (principal, action == Action::"editDemographicInformation", resource is DemographicInformation) when { context.session.isActive && ((principal is Patient && context.session has patient && context.session.patient == principal && resource.patient == principal) || (principal is User && context.session.user == principal && resource.patient.personalRepresentatives.contains(principal)) || (principal is UnlicensedPersonnel && context.session has unlicensedPersonnel && context.session.unlicensedPersonnel == principal) || (principal is HealthCareProfessional && context.session has healthCareProfessional && context.session.healthCareProfessional == principal && context.mid == resource.patient.mid && !context.includesSecurityQuestionOrPassword)) };

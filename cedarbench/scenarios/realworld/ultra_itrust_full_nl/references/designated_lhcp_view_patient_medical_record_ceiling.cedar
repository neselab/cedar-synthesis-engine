permit (principal, action == Action::"viewMedicalRecord", resource is MedicalRecord) when { context.session.isActive && ((principal is Patient && context.session has patient && context.session.patient == principal && resource.patient == principal) || (principal is User && context.session.user == principal && resource.patient.personalRepresentatives.contains(principal)) || (principal is LicensedHealthCareProfessional && context.session has licensedHealthCareProfessional && context.session.licensedHealthCareProfessional == principal && resource.patient.designatedLHCPs.contains(principal)) || (principal is UnlicensedPersonnel && context.session has unlicensedPersonnel && context.session.unlicensedPersonnel == principal)) };

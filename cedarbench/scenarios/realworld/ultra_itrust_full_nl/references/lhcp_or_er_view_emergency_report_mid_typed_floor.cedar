permit (principal, action == Action::"viewEmergencyReport", resource is EmergencyReport) when { context.session.isActive && context.mid == resource.patient.mid && ((principal is LicensedHealthCareProfessional && context.session has licensedHealthCareProfessional && context.session.licensedHealthCareProfessional == principal) || (principal is EmergencyResponder && context.session has emergencyResponder && context.session.emergencyResponder == principal)) };
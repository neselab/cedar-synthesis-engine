permit (principal is User, action == Action::"sendMessage", resource is Message) when { context.session.isActive && context.session has user && context.session has user && context.session has user && context.session.user == principal && resource.sender == principal && resource has patient && resource.patient == context.patient && resource has lhcpRecipient && context.patient.designatedLHCPs.contains(resource.lhcpRecipient) && (principal == context.patient || context.patient.personalRepresentatives.contains(principal)) && !(resource has patientRecipient) && !(resource has personalRepresentativeRecipient) };
permit (principal, action == Action::"modifyOfficeVisit", resource is OfficeVisit) when { context.session.isActive && ((principal is HealthCareProfessional && context.session has healthCareProfessional && context.session.healthCareProfessional == principal) || (principal is UnlicensedPersonnel && context.session has unlicensedPersonnel && context.session.unlicensedPersonnel == principal)) };
permit (principal, action == Action::"sendMessage", resource is Message) when { ((principal is LicensedHealthCareProfessional && context.session.isActive && context.session has licensedHealthCareProfessional && context.session.licensedHealthCareProfessional == principal && resource.sender == principal && resource has patient && resource.patient == context.patient && context.patient.designatedLHCPs.contains(principal) && !(resource has lhcpRecipient) && (((resource has patientRecipient && resource.patientRecipient == context.patient) && !(resource has personalRepresentativeRecipient)) || (!(resource has patientRecipient) && (resource has personalRepresentativeRecipient && context.patient.personalRepresentatives.contains(resource.personalRepresentativeRecipient))))) || (principal is User && context.session.isActive && context.session.user == principal && resource.sender == principal && resource has patient && resource.patient == context.patient && resource has lhcpRecipient && context.patient.designatedLHCPs.contains(resource.lhcpRecipient) && (principal == context.patient || context.patient.personalRepresentatives.contains(principal)) && !(resource has patientRecipient) && !(resource has personalRepresentativeRecipient))) };

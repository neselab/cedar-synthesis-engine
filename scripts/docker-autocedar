#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
IMAGE="${AUTOCEDAR_DOCKER_IMAGE:-autocedar}"

cd "$REPO_ROOT"

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is not installed or is not on PATH."
  echo "Install Docker, then run this script again."
  exit 1
fi

DOCKER=(docker)
if ! docker info >/dev/null 2>&1; then
  if command -v sudo >/dev/null 2>&1; then
    echo "Docker needs elevated permission on this machine; using sudo."
    sudo -v
    DOCKER=(sudo docker)
  else
    echo "Docker is not reachable, and sudo is not available."
    echo "Start Docker or add your user to the docker group."
    exit 1
  fi
fi

if ! "${DOCKER[@]}" info >/dev/null 2>&1; then
  echo "Docker daemon is not reachable."
  echo "On Linux, try: sudo systemctl enable --now docker"
  exit 1
fi

USER_ID="$(id -u):$(id -g)"

echo "Building Docker image: $IMAGE"
"${DOCKER[@]}" build -t "$IMAGE" "$REPO_ROOT"

if [[ "${1:-}" == "apikey" || "${1:-}" == "api-key" ]]; then
  if [[ -t 0 && -t 1 ]]; then
    exec "${DOCKER[@]}" run \
      --rm \
      -it \
      --user "$USER_ID" \
      --volume "$REPO_ROOT:/work" \
      --workdir /work \
      "$IMAGE" \
      "$@"
  fi
  exec "${DOCKER[@]}" run \
    --rm \
    --user "$USER_ID" \
    --volume "$REPO_ROOT:/work" \
    --workdir /work \
    "$IMAGE" \
    "$@"
fi

NEEDS_API_KEY=0
if [[ ! -f "$REPO_ROOT/.env" ]]; then
  NEEDS_API_KEY=1
elif ! grep -Eq '^[[:space:]]*(export[[:space:]]+)?ANTHROPIC_API_KEY[[:space:]]*=' "$REPO_ROOT/.env"; then
  NEEDS_API_KEY=1
elif grep -Eq '^[[:space:]]*(export[[:space:]]+)?ANTHROPIC_API_KEY[[:space:]]*=[[:space:]]*"?sk-ant-(\.\.\.|…)"?[[:space:]]*$' "$REPO_ROOT/.env"; then
  NEEDS_API_KEY=1
fi

if [[ "$NEEDS_API_KEY" -eq 1 ]]; then
  echo "ANTHROPIC_API_KEY is not configured in $REPO_ROOT/.env."
  if [[ -t 0 && -t 1 ]]; then
    echo "AutoCedar will ask for it now and save it to .env."
    "${DOCKER[@]}" run \
      --rm \
      -it \
      --user "$USER_ID" \
      --volume "$REPO_ROOT:/work" \
      --workdir /work \
      "$IMAGE" \
      apikey
  else
    echo "Run: ./scripts/docker-autocedar apikey sk-ant-..."
    exit 1
  fi
fi

echo "Checking AutoCedar environment inside Docker..."
"${DOCKER[@]}" run \
  --rm \
  --user "$USER_ID" \
  --env-file "$REPO_ROOT/.env" \
  --volume "$REPO_ROOT:/work" \
  --workdir /work \
  "$IMAGE" \
  doctor

if [[ -t 0 && -t 1 ]]; then
  echo "Starting AutoCedar in Docker..."
  exec "${DOCKER[@]}" run \
    --rm \
    -it \
    --user "$USER_ID" \
    --env-file "$REPO_ROOT/.env" \
    --volume "$REPO_ROOT:/work" \
    --workdir /work \
    "$IMAGE" \
    "$@"
elif [[ $# -eq 0 || "$1" == "tui" ]]; then
  echo "AutoCedar TUI needs an interactive terminal."
  echo "For a non-interactive setup check, run: ./scripts/docker-autocedar doctor"
  exit 1
fi

echo "Starting AutoCedar in Docker..."
exec "${DOCKER[@]}" run \
  --rm \
  --user "$USER_ID" \
  --env-file "$REPO_ROOT/.env" \
  --volume "$REPO_ROOT:/work" \
  --workdir /work \
  "$IMAGE" \
  "$@"

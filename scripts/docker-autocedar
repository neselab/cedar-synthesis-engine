#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
IMAGE="${AUTOCEDAR_DOCKER_IMAGE:-autocedar}"

cd "$REPO_ROOT"

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is not installed or is not on PATH."
  echo "Install Docker, then run this script again."
  exit 1
fi

DOCKER=(docker)
if ! docker info >/dev/null 2>&1; then
  if command -v sudo >/dev/null 2>&1; then
    echo "Docker needs elevated permission on this machine; using sudo."
    sudo -v
    DOCKER=(sudo docker)
  else
    echo "Docker is not reachable, and sudo is not available."
    echo "Start Docker or add your user to the docker group."
    exit 1
  fi
fi

if ! "${DOCKER[@]}" info >/dev/null 2>&1; then
  echo "Docker daemon is not reachable."
  echo "On Linux, try: sudo systemctl enable --now docker"
  exit 1
fi

USER_ID="$(id -u):$(id -g)"
ENV_ARGS=()
if [[ -f "$REPO_ROOT/.env" ]]; then
  ENV_ARGS=(--env-file "$REPO_ROOT/.env")
fi

# The container runs as the host user, so /root is not a safe writable HOME.
# Persist AutoCedar's split settings/auth store on the host and present it under
# a writable container HOME. Override the host path when isolation is desired.
HOST_CONFIG_DIR="${AUTOCEDAR_DOCKER_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/autocedar}"
CONTAINER_HOME="/home/autocedar"
mkdir -p "$HOST_CONFIG_DIR"
chmod 700 "$HOST_CONFIG_DIR"
MOUNT_ARGS=(
  --env "HOME=$CONTAINER_HOME"
  --volume "$HOST_CONFIG_DIR:$CONTAINER_HOME/.config/autocedar"
  --volume "$REPO_ROOT:/work"
  --workdir /work
)
if [[ -d "$HOME/.codex" ]]; then
  MOUNT_ARGS+=(--volume "$HOME/.codex:$CONTAINER_HOME/.codex:ro")
fi

echo "Building Docker image: $IMAGE"
"${DOCKER[@]}" build -t "$IMAGE" "$REPO_ROOT"

if [[ "${1:-}" == "apikey" || "${1:-}" == "api-key" ]]; then
  if [[ -t 0 && -t 1 ]]; then
    exec "${DOCKER[@]}" run \
      --rm \
      -it \
      --user "$USER_ID" \
      "${ENV_ARGS[@]}" \
      "${MOUNT_ARGS[@]}" \
      "$IMAGE" \
      "$@"
  fi
  exec "${DOCKER[@]}" run \
    --rm \
    --user "$USER_ID" \
    "${ENV_ARGS[@]}" \
    "${MOUNT_ARGS[@]}" \
    "$IMAGE" \
    "$@"
fi

echo "Checking AutoCedar environment inside Docker..."
"${DOCKER[@]}" run \
  --rm \
  --user "$USER_ID" \
  "${ENV_ARGS[@]}" \
  "${MOUNT_ARGS[@]}" \
  "$IMAGE" \
  doctor

if [[ -t 0 && -t 1 ]]; then
  echo "Starting AutoCedar in Docker..."
  exec "${DOCKER[@]}" run \
    --rm \
    -it \
    --user "$USER_ID" \
    "${ENV_ARGS[@]}" \
    "${MOUNT_ARGS[@]}" \
    "$IMAGE" \
    "$@"
elif [[ $# -eq 0 || "$1" == "tui" ]]; then
  echo "AutoCedar TUI needs an interactive terminal."
  echo "For a non-interactive setup check, run: ./scripts/docker-autocedar doctor"
  exit 1
fi

echo "Starting AutoCedar in Docker..."
exec "${DOCKER[@]}" run \
  --rm \
  --user "$USER_ID" \
  "${ENV_ARGS[@]}" \
  "${MOUNT_ARGS[@]}" \
  "$IMAGE" \
  "$@"

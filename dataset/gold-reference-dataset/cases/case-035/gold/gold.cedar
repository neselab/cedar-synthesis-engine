permit (principal is User, action == Action::"readSecret", resource is NamespaceSecret)
when { ((((principal.clearance == 0) || (principal.clearance == 1) || (principal.clearance == 2)) && ((resource.sensitivity == 0) || (resource.sensitivity == 1) || (resource.sensitivity == 2))) && ((principal.roles.contains(Role::"Deployer") || principal.roles.contains(Role::"Maintainer") || principal.roles.contains(Role::"ClusterOperator") || principal.roles.contains(Role::"ServiceAccount"))) && (!(true) || (resource.status == NamespaceSecretStatusValue::"active")) && ((principal == resource.owner)) && (((context.presentedToken.subject == principal) && (context.presentedToken.boundNamespace == resource.namespace) && (context.currentTime < context.presentedToken.expiresAt))) && (context.mfaUsed) && (resource.namespace.members.contains(principal))) };

permit (principal is User, action == Action::"approveAward", resource is Award)
when { ((((principal.approvalAuthority == 0) || (principal.approvalAuthority == 1) || (principal.approvalAuthority == 2)) && (resource.amount >= 0) && ((resource.application.fundingTier == 0) || (resource.application.fundingTier == 1) || (resource.application.fundingTier == 2))) && ((principal.roles.contains(Role::"ProgramOfficer") || principal.roles.contains(Role::"GrantsOfficer"))) && (!(((resource.amount > 10000000))) || (principal.approvalAuthority >= resource.application.fundingTier) || (context.emergencyDeclared && (principal.roles.contains(Role::"ProgramOfficer")))) && (!(true) || (resource.status == AwardStatusValue::"pending")) && (context.onGovNetwork)) };

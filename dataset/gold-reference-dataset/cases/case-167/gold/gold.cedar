permit (principal is User, action == Action::"authorizeSwitching", resource is SwitchingOrder)
when { ((((resource.voltageLevel == 0) || (resource.voltageLevel == 1) || (resource.voltageLevel == 2) || (resource.voltageLevel == 3))) && ((principal.roles.contains(Role::"Planner") || principal.roles.contains(Role::"ShiftSupervisor"))) && (!(true) || (principal != resource.executor) || (context.outageEmergencyDeclared && (principal.roles.contains(Role::"ShiftSupervisor")))) && (((resource.scheduledStart <= context.currentTime) && (context.currentTime < resource.scheduledEnd))) && (!((resource.voltageLevel >= 1)) || (principal.roles.contains(Role::"ShiftSupervisor"))) && (context.onScadaNetwork)) };

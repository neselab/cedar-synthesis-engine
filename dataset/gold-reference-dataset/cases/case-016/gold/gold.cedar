permit (principal is User, action == Action::"applyComp", resource is CompAuthorization)
when { ((((principal.compAuthorityLevel == 0) || (principal.compAuthorityLevel == 1) || (principal.compAuthorityLevel == 2) || (principal.compAuthorityLevel == 3)) && (resource.compValue >= 0) && ((resource.guestTier == 0) || (resource.guestTier == 1) || (resource.guestTier == 2) || (resource.guestTier == 3))) && ((principal.roles.contains(Role::"FrontDeskAgent") || principal.roles.contains(Role::"GuestServicesHost"))) && (!(true) || (principal.compAuthorityLevel >= resource.guestTier)) && ((resource.loyaltyGroup in principal.assignedGroup)) && (!(resource.perks.contains("beverage_credit")) || context.voucherPerks.contains("beverage_credit"))) };

permit (principal is User, action == Action::"authorizeComp", resource is CompAuthorization)
when { (((resource.compValue >= 0) && (resource.itemCount >= 0)) && ((principal.roles.contains(Role::"ShiftManager") || principal.roles.contains(Role::"FrontOfficeManager"))) && (!(((resource.itemCount > 1))) || (principal != resource.requestedBy)) && (!((resource.compValue > 50000)) || (principal.roles.contains(Role::"FrontOfficeManager")))) };

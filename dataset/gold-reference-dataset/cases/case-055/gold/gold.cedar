permit (principal is User, action == Action::"viewRecord", resource is MedicalRecord)
when { ((((principal.clearedFor == 0) || (principal.clearedFor == 1) || (principal.clearedFor == 2)) && ((resource.sensitivity == 0) || (resource.sensitivity == 1) || (resource.sensitivity == 2))) && ((principal.roles.contains(Role::"AttendingPhysician") || principal.roles.contains(Role::"Resident") || principal.roles.contains(Role::"Nurse"))) && (!(true) || (principal.clearedFor >= resource.sensitivity)) && (((("open" == "open") && (resource.status == MedicalRecordStatusValue::"open")) || (("open" == "finalized") && (resource.status == MedicalRecordStatusValue::"finalized")) || (("open" == "sealed") && (resource.status == MedicalRecordStatusValue::"sealed")))) && (((("context.currentShift" == "context.currentShift") && context.currentShift) || (("context.currentShift" == "context.mfaUsed") && context.mfaUsed))) && (resource.careTeam.contains(principal)) && ((principal.ward == resource.ward))) };

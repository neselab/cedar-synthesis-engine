permit (principal is User, action == Action::"sendCommand", resource is Device)
when { (true && ((principal.roles.contains(Role::"Operator") || principal.roles.contains(Role::"Technician") || principal.roles.contains(Role::"FleetAdmin"))) && (!(true) || (resource.status == DeviceStatusValue::"active") || ((context.maintenanceWindow && (principal.roles.contains(Role::"Technician"))) && (resource.status == DeviceStatusValue::"maintenance"))) && (resource.firmwareTags.contains("security_patch")) && ((principal.memberOf in resource.siteGroup)) && (context.sourceIp.isInRange(ip("172.16.0.0/12")))) };

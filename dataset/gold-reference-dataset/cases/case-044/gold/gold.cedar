permit (principal is User, action == Action::"applyManifest", resource is Workload)
when { (((resource.replicaCount >= 0)) && ((principal.roles.contains(Role::"Deployer") || principal.roles.contains(Role::"Maintainer") || principal.roles.contains(Role::"ClusterOperator"))) && (!(((resource.replicaCount > 50))) || (principal != resource.creator)) && (resource.labels.contains("external")) && ((principal.grantedScope == resource.requiredVerb)) && (context.sourceIp.isInRange(ip("172.16.0.0/12")))) };

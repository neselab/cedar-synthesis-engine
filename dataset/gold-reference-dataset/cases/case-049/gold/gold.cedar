permit (principal is User, action == Action::"overrideSchedule", resource is Zone)
when { ((((principal.controlTier == 0) || (principal.controlTier == 1) || (principal.controlTier == 2)) && ((resource.criticality == 0) || (resource.criticality == 1) || (resource.criticality == 2))) && ((principal.roles.contains(Role::"ZoneController") || principal.roles.contains(Role::"FacilityManager"))) && (!(true) || (principal.controlTier >= resource.criticality)) && ((principal == resource.controller)) && (((("active" == "scheduled") && (resource.status == ZoneStatusValue::"scheduled")) || (("active" == "active") && (resource.status == ZoneStatusValue::"active")) || (("active" == "overridden") && (resource.status == ZoneStatusValue::"overridden")) || (("active" == "locked") && (resource.status == ZoneStatusValue::"locked")))) && (context.occupancyDetected) && ((principal.roles.contains(Role::"FacilityManager")))) };

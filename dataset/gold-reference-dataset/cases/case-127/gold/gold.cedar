permit (principal is User, action == Action::"viewDocument", resource is Document)
when { ((((principal.clearance == 0) || (principal.clearance == 1) || (principal.clearance == 2) || (principal.clearance == 3)) && ((resource.classification == 0) || (resource.classification == 1) || (resource.classification == 2) || (resource.classification == 3))) && ((principal.roles.contains(Role::"Author") || principal.roles.contains(Role::"Editor") || principal.roles.contains(Role::"Viewer") || principal.roles.contains(Role::"ComplianceOfficer"))) && (!(true) || (principal.clearance >= resource.classification)) && (resource.labels.contains("external")) && (resource.shareList.contains(principal)) && (context.onCorpNetwork)) };

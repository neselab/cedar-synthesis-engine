permit (principal is User, action == Action::"issuePayout", resource is Payout)
when { (((resource.amount >= 0) && (resource.claim.claimAmount >= 0) && (resource.claim.deductible >= 0) && (resource.claim.lineItemCount >= 0)) && ((principal.roles.contains(Role::"PayoutOfficer") || principal.roles.contains(Role::"ClaimsManager"))) && (!(((resource.claim.lineItemCount > 100))) || (principal != resource.claim.approver) || (context.catastropheDeclared && (principal.roles.contains(Role::"ClaimsManager")))) && ((resource.claim.fraudHold == false)) && (context.onCorporateNetwork)) };

permit (principal is User, action == Action::"approveBudget", resource is Campaign)
when { (((resource.budget >= 0) && ((resource.budgetTier == 0) || (resource.budgetTier == 1) || (resource.budgetTier == 2)) && (resource.contingency >= 0)) && ((principal.roles.contains(Role::"CampaignDirector") || principal.roles.contains(Role::"AccountManager"))) && (!(((resource.budget > 1000000))) || (principal != resource.preparedBy)) && (!(true) || (resource.status == CampaignStatusValue::"review")) && (context.mfaUsed) && (!((resource.budgetTier >= 2)) || (principal.roles.contains(Role::"CampaignDirector")))) };

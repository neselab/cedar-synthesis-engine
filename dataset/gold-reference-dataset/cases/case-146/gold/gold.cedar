permit (principal is User, action == Action::"applyManifest", resource is Workload)
when { (((resource.replicaCount >= 0)) && ((principal.roles.contains(Role::"Deployer") || principal.roles.contains(Role::"Maintainer") || principal.roles.contains(Role::"ClusterOperator"))) && (!(true) || ((resource.environment != WorkloadEnvironmentValue::"prod") || resource.namespace.promoted) || (context.emergencyChange && (principal.roles.contains(Role::"ClusterOperator")))) && (resource.labels.contains("external")) && ((principal.memberOf in resource.namespace.teamGroup)) && (context.sourceIp.isInRange(ip("10.0.0.0/8")))) };

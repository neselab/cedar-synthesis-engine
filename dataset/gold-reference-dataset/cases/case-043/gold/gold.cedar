permit (principal is User, action == Action::"viewDocument", resource is Document)
when { (true && ((principal.roles.contains(Role::"Attorney") || principal.roles.contains(Role::"Paralegal") || principal.roles.contains(Role::"RecordsManager"))) && (!(true) || ((resource.status != DocumentStatusValue::"sealed") || resource.filed)) && ((principal == resource.author)) && (((context.viewDocumentScheduledStart <= context.currentDate) && (context.currentDate < context.viewDocumentScheduledEnd))) && (!((resource.privileged == true)) || context.privilegedAccessAuthorized) && ((principal.roles.contains(Role::"Attorney")))) };

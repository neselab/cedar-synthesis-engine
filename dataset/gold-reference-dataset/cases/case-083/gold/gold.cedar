permit (principal is User, action == Action::"approveException", resource is Application)
when { (((resource.premium >= 0)) && ((principal.roles.contains(Role::"SeniorUnderwriter") || principal.roles.contains(Role::"UnderwritingManager") || principal.roles.contains(Role::"ChiefUnderwriter"))) && (!(true) || (principal == resource.assignedUnderwriter)) && (!(resource.coverageLines.contains("commercial_property")) || context.coverageExceptionReviewCompleted) && (!((resource.premium > 1000000)) || (principal.roles.contains(Role::"UnderwritingManager") || principal.roles.contains(Role::"ChiefUnderwriter")))) };

permit (principal is User, action == Action::"bindPolicy", resource is Application)
when { ((((principal.authorityLevel == 0) || (principal.authorityLevel == 1) || (principal.authorityLevel == 2) || (principal.authorityLevel == 3)) && (resource.premium >= 0) && ((resource.riskTier == 0) || (resource.riskTier == 1) || (resource.riskTier == 2) || (resource.riskTier == 3))) && ((principal.roles.contains(Role::"Underwriter") || principal.roles.contains(Role::"SeniorUnderwriter") || principal.roles.contains(Role::"UnderwritingManager"))) && (!(true) || (resource.status == ApplicationStatusValue::"quoted")) && (resource.segment.contains("commercial")) && (resource.coverageLines.contains("controlled_liability"))) };

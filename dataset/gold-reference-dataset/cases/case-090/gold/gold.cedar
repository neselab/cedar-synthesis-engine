permit (principal is User, action == Action::"approveClaim", resource is Claim)
when { (((resource.claimAmount >= 0) && (resource.deductible >= 0) && (resource.lineItemCount >= 0)) && ((principal.roles.contains(Role::"Reviewer") || principal.roles.contains(Role::"ClaimsManager"))) && (!(true) || (principal != resource.handler) || (context.catastropheDeclared && (principal.roles.contains(Role::"ClaimsManager")))) && ((resource.claimCode like "AUTO-*"))) };

permit (principal is User, action == Action::"issuePayout", resource is Payout)
when { (((resource.amount >= 0) && (resource.claim.claimAmount >= 0) && (resource.claim.deductible >= 0) && (resource.claim.lineItemCount >= 0)) && ((principal.roles.contains(Role::"PayoutOfficer") || principal.roles.contains(Role::"ClaimsManager"))) && (!(true) || (resource.claim.status == ClaimStatusValue::"approved")) && ((resource.claim.claimCode like "LIABILITY-*")) && ((resource.amount == (resource.claim.claimAmount - resource.claim.deductible)))) };

permit (principal is User, action == Action::"viewModule", resource is Module)
when { ((((principal.completedLevel == 0) || (principal.completedLevel == 1) || (principal.completedLevel == 2)) && ((resource.prereqLevel == 0) || (resource.prereqLevel == 1) || (resource.prereqLevel == 2))) && ((principal.roles.contains(Role::"InstructorOfRecord") || principal.roles.contains(Role::"TeachingAssistant") || principal.roles.contains(Role::"Learner") || principal.roles.contains(Role::"Coordinator"))) && (!(true) || (principal.completedLevel >= resource.prereqLevel)) && (!((resource.locked == true))) && ((principal.roles.contains(Role::"Coordinator"))) && (resource.roster.contains(principal)) && (context.onInstitutionNetwork)) };

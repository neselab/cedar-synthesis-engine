permit (principal is User, action == Action::"approveClearToClose", resource is EscrowFile)
when { (((resource.heldAmount >= 0) && (resource.payeeCount >= 0)) && ((principal.roles.contains(Role::"TitleOfficer") || principal.roles.contains(Role::"EscrowManager"))) && (!(true) || (principal != resource.escrowOfficer)) && (!(resource.parties.containsAny(context.enhancedDueDiligenceParties)) || context.enhancedDueDiligenceCompleted) && (!((resource.payeeCount > 2)) || (principal.roles.contains(Role::"EscrowManager")))) };

permit (principal is User, action == Action::"authorizeDisbursement", resource is Disbursement)
when { ((((principal.authorityLevel == 0) || (principal.authorityLevel == 1) || (principal.authorityLevel == 2) || (principal.authorityLevel == 3)) && (resource.amount >= 0) && ((resource.escrowFile.disbursementTier == 0) || (resource.escrowFile.disbursementTier == 1) || (resource.escrowFile.disbursementTier == 2) || (resource.escrowFile.disbursementTier == 3)) && (resource.escrowFile.heldAmount >= 0)) && ((principal.roles.contains(Role::"SeniorEscrowOfficer") || principal.roles.contains(Role::"EscrowManager"))) && (!(true) || (principal.authorityLevel >= resource.escrowFile.disbursementTier)) && (!(resource.escrowFile.lienStatus.contains("tax_lien"))) && (context.onCorporateNetwork)) };

permit (principal is User, action == Action::"clearSecurityCheck", resource is SecurityCheck)
when { (true && ((principal.roles.contains(Role::"BackgroundInvestigator") || principal.roles.contains(Role::"SupervisoryOfficer"))) && (!(true) || (principal == resource.investigator)) && (!(true) || (resource.status == SecurityCheckStatusValue::"pending")) && (((context.clearSecurityCheckScheduledStart <= context.currentTime) && (context.currentTime < context.clearSecurityCheckScheduledEnd))) && ((principal.roles.contains(Role::"BackgroundInvestigator"))) && (context.onGovNetwork)) };

permit (principal is User, action == Action::"publishListing", resource is Listing)
when { ((((principal.verifiedTier == 0) || (principal.verifiedTier == 1) || (principal.verifiedTier == 2) || (principal.verifiedTier == 3)) && ((resource.categoryTier == 1) || (resource.categoryTier == 2) || (resource.categoryTier == 3)) && (resource.price >= 0)) && ((principal.roles.contains(Role::"Seller"))) && (!(true) || (principal.verifiedTier >= resource.categoryTier)) && ((principal == resource.owner)) && (resource.riskLabels.contains("restricted")) && (context.mfaUsed) && (!((resource.price > 200000)) || context.publishListingV8ReviewCompleted)) };

permit (principal is User, action == Action::"readSecret", resource is NamespaceSecret)
when { ((((principal.clearance == 0) || (principal.clearance == 1) || (principal.clearance == 2)) && ((resource.sensitivity == 0) || (resource.sensitivity == 1) || (resource.sensitivity == 2))) && ((principal.roles.contains(Role::"Deployer") || principal.roles.contains(Role::"Maintainer") || principal.roles.contains(Role::"ClusterOperator") || principal.roles.contains(Role::"ServiceAccount"))) && (!(true) || (principal.clearance >= resource.sensitivity)) && (!(true) || (resource.status == NamespaceSecretStatusValue::"active")) && (context.sourceIp.isInRange(ip("10.0.0.0/8")))) };

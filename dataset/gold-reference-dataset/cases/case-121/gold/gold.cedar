permit (principal is User, action == Action::"issueRefund", resource is Refund)
when { (((resource.amount >= 0) && (resource.order.itemTotal >= 0) && ((resource.order.loyaltyTier == 0) || (resource.order.loyaltyTier == 1) || (resource.order.loyaltyTier == 2)) && (resource.order.taxAmount >= 0)) && ((principal.roles.contains(Role::"ServiceRep") || principal.roles.contains(Role::"Manager"))) && (!((((resource.order.itemTotal > 10000) || (resource.order.taxAmount > (10000 - resource.order.itemTotal))) || (resource.amount > 5000))) || (principal != resource.order.placedBy)) && (!(true) || (resource.order.status == OrderStatusValue::"shipped")) && ((resource.order.loyaltyTier >= 2))) };

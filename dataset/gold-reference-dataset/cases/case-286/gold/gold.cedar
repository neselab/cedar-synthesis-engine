permit (principal is User, action == Action::"approveChange", resource is ChangeRequest)
when { ((((principal.authorityLevel == 0) || (principal.authorityLevel == 1) || (principal.authorityLevel == 2) || (principal.authorityLevel == 3)) && (resource.affectedNodeCount >= 0) && ((resource.changeRisk == 0) || (resource.changeRisk == 1) || (resource.changeRisk == 2) || (resource.changeRisk == 3)) && (resource.estimatedCost >= 0) && (resource.rollbackStepCount >= 0)) && ((principal.roles.contains(Role::"ChangeManager") || principal.roles.contains(Role::"CABApprover"))) && (!(true) || (principal.authorityLevel >= resource.changeRisk)) && (!(((resource.affectedNodeCount > 10) || (resource.rollbackStepCount > (10 - resource.affectedNodeCount)))) || context.approveChangeV7ReviewCompleted) && (!((resource.estimatedCost > 1000000)) || (principal.roles.contains(Role::"CABApprover")))) };

permit (principal is User, action == Action::"implementChange", resource is ChangeRequest)
when { (((resource.affectedNodeCount >= 0)) && ((principal.roles.contains(Role::"NetworkEngineer") || principal.roles.contains(Role::"SeniorEngineer"))) && (!(true) || (resource.status == ChangeRequestStatusValue::"approved")) && ((((((resource.maintenanceWindowStart < datetime("1970-01-01T00:00:00Z")) && (context.currentTime < datetime("1970-01-01T00:00:00Z"))) || ((datetime("1970-01-01T00:00:00Z") <= resource.maintenanceWindowStart) && (datetime("1970-01-01T00:00:00Z") <= context.currentTime))) && (resource.maintenanceWindowStart <= context.currentTime) && (context.currentTime.durationSince(resource.maintenanceWindowStart).toMilliseconds() < 14400000)) || ((resource.maintenanceWindowStart < datetime("1970-01-01T00:00:00Z")) && (datetime("1969-01-01T00:00:00Z") <= resource.maintenanceWindowStart) && (datetime("1970-01-01T00:00:00Z") <= context.currentTime) && (context.currentTime.durationSince(datetime("1970-01-01T00:00:00Z")).toMilliseconds() < 14400000) && (context.currentTime.durationSince(datetime("1970-01-01T00:00:00Z")).toMilliseconds() < (14400000 - datetime("1970-01-01T00:00:00Z").durationSince(resource.maintenanceWindowStart).toMilliseconds())))) || (resource.emergencyChange == true))) };

permit (principal is User, action == Action::"approveAdjustment", resource is Folio)
when { (((resource.adjustmentAmount >= 0) && (resource.folioBalance >= 0)) && ((principal.roles.contains(Role::"AccountingClerk") || principal.roles.contains(Role::"RevenueManager"))) && (!(true) || (resource.status == FolioStatusValue::"adjustment_posted")) && ((resource.propertyRegion in principal.assignedGroup)) && (!((resource.adjustmentAmount > 10000)) || context.largeCreditApprovalRecorded)) };

permit (principal is User, action == Action::"postAdjustment", resource is Folio)
when { ((((principal.adjustmentAuthorityLevel == 0) || (principal.adjustmentAuthorityLevel == 1) || (principal.adjustmentAuthorityLevel == 2) || (principal.adjustmentAuthorityLevel == 3)) && (resource.adjustmentAmount >= 0) && ((resource.guestSegment == 0) || (resource.guestSegment == 1) || (resource.guestSegment == 2) || (resource.guestSegment == 3)) && (resource.originalCharge >= 0)) && ((principal.roles.contains(Role::"FrontDeskAgent") || principal.roles.contains(Role::"NightAuditor"))) && (!((((resource.originalCharge - resource.adjustmentAmount) > 250000))) || (principal.adjustmentAuthorityLevel >= resource.guestSegment)) && (resource.disputeCategory.contains("billing_error"))) };

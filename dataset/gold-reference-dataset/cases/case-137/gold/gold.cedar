permit (principal is User, action == Action::"approveWire", resource is WireTransfer)
when { ((((principal.approvalTier == 0) || (principal.approvalTier == 1) || (principal.approvalTier == 2)) && (resource.amount >= 0) && ((resource.amountTier == 0) || (resource.amountTier == 1) || (resource.amountTier == 2)) && (resource.fee >= 0)) && ((principal.roles.contains(Role::"Verifier") || principal.roles.contains(Role::"TreasuryOfficer"))) && (!((((resource.amount > 7500000) || (resource.fee > (7500000 - resource.amount))) || (resource.amount > 5000000))) || (principal != resource.initiatedBy)) && (resource.account.allowedBeneficiaries.contains(resource.beneficiary)) && (context.onSecureNetwork)) };

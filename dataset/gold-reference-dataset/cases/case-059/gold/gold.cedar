permit (principal is User, action == Action::"readDocument", resource is Document)
when { ((((principal.clearance == 0) || (principal.clearance == 1) || (principal.clearance == 2) || (principal.clearance == 3)) && ((resource.classification == 0) || (resource.classification == 1) || (resource.classification == 2) || (resource.classification == 3))) && ((principal.roles.contains(Role::"Analyst") || principal.roles.contains(Role::"Officer"))) && (!(true) || (principal.clearance >= resource.classification)) && (((("released" == "draft") && (resource.status == DocumentStatusValue::"draft")) || (("released" == "released") && (resource.status == DocumentStatusValue::"released")) || (("released" == "archived") && (resource.status == DocumentStatusValue::"archived")))) && (resource.compartments.contains("CHARLIE")) && (context.onIntranet)) };

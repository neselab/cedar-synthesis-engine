permit (principal is User, action == Action::"readTelemetry", resource is Telemetry)
when { ((((principal.clearance == 0) || (principal.clearance == 1) || (principal.clearance == 2)) && ((resource.sensitivity == 0) || (resource.sensitivity == 1) || (resource.sensitivity == 2))) && ((principal.roles.contains(Role::"Operator") || principal.roles.contains(Role::"FleetAdmin"))) && (!(true) || (principal.clearance >= resource.sensitivity)) && ((principal == resource.device.owner)) && (((("decommissioned" == "provisioned") && (resource.device.status == DeviceStatusValue::"provisioned")) || (("decommissioned" == "active") && (resource.device.status == DeviceStatusValue::"active")) || (("decommissioned" == "maintenance") && (resource.device.status == DeviceStatusValue::"maintenance")) || (("decommissioned" == "decommissioned") && (resource.device.status == DeviceStatusValue::"decommissioned")))) && (context.sourceIp.isInRange(ip("192.168.0.0/16")))) };

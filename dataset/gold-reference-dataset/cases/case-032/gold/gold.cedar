permit (principal is User, action == Action::"accessApplication", resource is PatentApplication)
when { ((((principal.clearance == 0) || (principal.clearance == 1) || (principal.clearance == 2)) && ((resource.confidentiality == 0) || (resource.confidentiality == 1) || (resource.confidentiality == 2))) && ((principal.roles.contains(Role::"PatentAttorney") || principal.roles.contains(Role::"DocketClerk") || principal.roles.contains(Role::"Examiner"))) && (!(true) || (principal.clearance >= resource.confidentiality)) && ((principal == resource.prosecutingAttorney)) && (((context.accessApplicationScheduledStart <= context.currentDate) && (context.currentDate < context.accessApplicationScheduledEnd))) && (((("filed" == "filed") && (resource.status == PatentApplicationStatusValue::"filed")) || (("filed" == "underExamination") && (resource.status == PatentApplicationStatusValue::"underExamination")) || (("filed" == "allowed") && (resource.status == PatentApplicationStatusValue::"allowed")) || (("filed" == "abandoned") && (resource.status == PatentApplicationStatusValue::"abandoned")))) && (context.onFirmNetwork)) };

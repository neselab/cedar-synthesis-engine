permit (principal is User, action == Action::"overrideSchedule", resource is Zone)
when { ((((principal.controlTier == 0) || (principal.controlTier == 1) || (principal.controlTier == 2)) && ((resource.criticality == 0) || (resource.criticality == 1) || (resource.criticality == 2))) && ((principal.roles.contains(Role::"ZoneController") || principal.roles.contains(Role::"FacilityManager"))) && (!(true) || (principal.controlTier >= resource.criticality)) && ((principal == resource.controller)) && (((context.overrideScheduleScheduledStart <= context.currentTime) && (context.currentTime < context.overrideScheduleScheduledEnd))) && (((("scheduled" == "scheduled") && (resource.status == ZoneStatusValue::"scheduled")) || (("scheduled" == "active") && (resource.status == ZoneStatusValue::"active")) || (("scheduled" == "overridden") && (resource.status == ZoneStatusValue::"overridden")) || (("scheduled" == "locked") && (resource.status == ZoneStatusValue::"locked")))) && (context.occupancyDetected)) };

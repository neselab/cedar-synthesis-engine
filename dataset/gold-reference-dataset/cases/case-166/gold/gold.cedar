permit (principal is User, action == Action::"sendCommand", resource is Device)
when { (true && ((principal.roles.contains(Role::"Operator") || principal.roles.contains(Role::"Technician") || principal.roles.contains(Role::"FleetAdmin"))) && (!(true) || (resource.status == DeviceStatusValue::"active")) && (resource.firmwareTags.contains("beta")) && ((principal.memberOf in resource.siteGroup)) && (context.sourceIp.isInRange(ip("192.168.0.0/16")))) };

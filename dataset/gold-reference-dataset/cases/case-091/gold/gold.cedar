permit (principal is User, action == Action::"approvePayroll", resource is PayrollRun)
when { (((resource.amount >= 0)) && ((principal.roles.contains(Role::"Manager") || principal.roles.contains(Role::"PayrollAdmin"))) && (!(((resource.amount > 2500000))) || (principal != resource.preparedBy)) && (((context.approvePayrollScheduledStart <= context.currentTime) && (context.currentTime < context.approvePayrollScheduledEnd))) && ((principal.roles.contains(Role::"Manager")))) };

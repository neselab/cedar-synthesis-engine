permit (principal is User, action == Action::"approveAdjustment", resource is Folio)
when { (((resource.adjustmentAmount >= 0) && (resource.folioBalance >= 0)) && ((principal.roles.contains(Role::"AccountingClerk") || principal.roles.contains(Role::"RevenueManager"))) && (!((((resource.folioBalance - resource.adjustmentAmount) > 10000))) || (principal != resource.postedBy)) && (resource.disputeCategory.contains("comp"))) };

permit (principal is User, action == Action::"postAdjustment", resource is Folio)
when { ((((principal.adjustmentAuthorityLevel == 0) || (principal.adjustmentAuthorityLevel == 1) || (principal.adjustmentAuthorityLevel == 2) || (principal.adjustmentAuthorityLevel == 3)) && (resource.adjustmentAmount >= 0) && ((resource.guestSegment == 0) || (resource.guestSegment == 1) || (resource.guestSegment == 2) || (resource.guestSegment == 3)) && (resource.originalCharge >= 0)) && ((principal.roles.contains(Role::"FrontDeskAgent") || principal.roles.contains(Role::"NightAuditor"))) && (!(true) || (resource.status == FolioStatusValue::"open")) && (context.disputeVerified) && (((principal.assignedCodePattern == "PROPERTY-B-*") && (resource.folioCode like "PROPERTY-B-*")))) };

permit (principal is User, action == Action::"viewRecord", resource is MedicalRecord)
when { ((((principal.clearedFor == 0) || (principal.clearedFor == 1) || (principal.clearedFor == 2)) && ((resource.sensitivity == 0) || (resource.sensitivity == 1) || (resource.sensitivity == 2))) && ((principal.roles.contains(Role::"AttendingPhysician") || principal.roles.contains(Role::"Resident") || principal.roles.contains(Role::"Nurse"))) && (!(true) || (principal.clearedFor >= resource.sensitivity)) && (((("context.mfaUsed" == "context.currentShift") && context.currentShift) || (("context.mfaUsed" == "context.mfaUsed") && context.mfaUsed))) && ((principal.roles.contains(Role::"AttendingPhysician"))) && (resource.careTeam.contains(principal))) };

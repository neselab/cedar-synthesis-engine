permit (principal is User, action == Action::"viewRecord", resource is StudentRecord)
when { ((((resource.studentAge >= 0) && (resource.studentAge <= 130))) && ((principal.roles.contains(Role::"Instructor") || principal.roles.contains(Role::"Student") || principal.roles.contains(Role::"Parent") || principal.roles.contains(Role::"Registrar"))) && (!(true) || ((resource.status != StudentRecordStatusValue::"withdrawn") || (principal.roles.contains(Role::"Registrar")))) && ((principal.roles.contains(Role::"Instructor"))) && (!((resource.studentAge < 18)) || context.minorRecordAccessAuthorized) && (context.onCampusNetwork)) };

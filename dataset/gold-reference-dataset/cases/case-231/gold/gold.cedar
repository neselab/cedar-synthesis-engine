permit (principal is User, action == Action::"publishListing", resource is Listing)
when { ((((principal.verifiedTier == 0) || (principal.verifiedTier == 1) || (principal.verifiedTier == 2) || (principal.verifiedTier == 3)) && ((resource.categoryTier == 1) || (resource.categoryTier == 2) || (resource.categoryTier == 3)) && (resource.price >= 0)) && ((principal.roles.contains(Role::"Seller"))) && (!(true) || (resource.status == ListingStatusValue::"draft")) && ((principal == resource.owner)) && (resource.riskLabels.contains("high_risk")) && ((resource.category like "STANDARD-*")) && (!((resource.price > 50000)) || context.publishListingV8ReviewCompleted)) };

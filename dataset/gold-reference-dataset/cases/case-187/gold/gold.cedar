permit (principal is User, action == Action::"cloneRepository", resource is Repository)
when { ((((principal.clearance == 0) || (principal.clearance == 1) || (principal.clearance == 2) || (principal.clearance == 3)) && ((resource.sensitivity == 0) || (resource.sensitivity == 1) || (resource.sensitivity == 2) || (resource.sensitivity == 3))) && ((principal.roles.contains(Role::"Developer") || principal.roles.contains(Role::"Reviewer") || principal.roles.contains(Role::"Maintainer") || principal.roles.contains(Role::"SecurityLead"))) && (!(true) || (principal.clearance >= resource.sensitivity)) && (((("incubating" == "incubating") && (resource.status == RepositoryStatusValue::"incubating")) || (("incubating" == "active") && (resource.status == RepositoryStatusValue::"active")) || (("incubating" == "archived") && (resource.status == RepositoryStatusValue::"archived")))) && (resource.topics.contains("security")) && (context.onVpn)) };

permit (principal is User, action == Action::"viewApplication", resource is Application)
when { ((((principal.piiClearance == 0) || (principal.piiClearance == 1) || (principal.piiClearance == 2)) && ((resource.piiSensitivity == 0) || (resource.piiSensitivity == 1) || (resource.piiSensitivity == 2))) && ((principal.roles.contains(Role::"Recruiter") || principal.roles.contains(Role::"HiringManager") || principal.roles.contains(Role::"Interviewer") || principal.roles.contains(Role::"Coordinator"))) && (!(true) || (principal.piiClearance >= resource.piiSensitivity)) && (((("interviewing" == "received") && (resource.status == ApplicationStatusValue::"received")) || (("interviewing" == "screening") && (resource.status == ApplicationStatusValue::"screening")) || (("interviewing" == "interviewing") && (resource.status == ApplicationStatusValue::"interviewing")) || (("interviewing" == "offer") && (resource.status == ApplicationStatusValue::"offer")) || (("interviewing" == "closed") && (resource.status == ApplicationStatusValue::"closed")))) && ((principal.roles.contains(Role::"Recruiter"))) && (resource.hiringTeam.contains(principal)) && (context.onCorpNetwork)) };

permit (principal is User, action == Action::"executeSwitching", resource is SwitchingOrder)
when { (((resource.circuitCount >= 0)) && ((principal.roles.contains(Role::"Operator") || principal.roles.contains(Role::"ControlRoomOperator"))) && (!(true) || (principal != resource.planner)) && (((resource.scheduledStart <= context.currentTime) && (context.currentTime < resource.scheduledEnd))) && (((principal.assignedCodePattern == "FEEDER-B-*") && (resource.feeder like "FEEDER-B-*"))) && (!((resource.circuitCount > 1)) || (principal.roles.contains(Role::"ControlRoomOperator"))) && (context.onScadaNetwork)) };

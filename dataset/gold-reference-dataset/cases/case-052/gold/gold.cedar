permit (principal is User, action == Action::"sendCommand", resource is Device)
when { (true && ((principal.roles.contains(Role::"Operator") || principal.roles.contains(Role::"Technician") || principal.roles.contains(Role::"FleetAdmin"))) && (!(true) || (resource.status == DeviceStatusValue::"active")) && (((context.sendCommandScheduledStart <= context.currentTime) && (context.currentTime < context.sendCommandScheduledEnd))) && (!((resource.maintenanceMode == true)) || context.maintenanceCommandAuthorized) && (resource.firmwareTags.contains("stable")) && (context.sourceIp.isInRange(ip("10.0.0.0/8")))) };

permit (principal is User, action == Action::"viewPage", resource is Page)
when { ((((principal.clearance == 0) || (principal.clearance == 1) || (principal.clearance == 2) || (principal.clearance == 3)) && ((resource.classification == 0) || (resource.classification == 1) || (resource.classification == 2) || (resource.classification == 3))) && ((principal.roles.contains(Role::"Reader") || principal.roles.contains(Role::"Contributor") || principal.roles.contains(Role::"Reviewer") || principal.roles.contains(Role::"SpaceAdmin"))) && (!(true) || (principal.clearance >= resource.classification)) && ((principal == resource.author)) && (((("draft" == "draft") && (resource.status == PageStatusValue::"draft")) || (("draft" == "in_review") && (resource.status == PageStatusValue::"in_review")) || (("draft" == "published") && (resource.status == PageStatusValue::"published")) || (("draft" == "archived") && (resource.status == PageStatusValue::"archived")))) && ((resource.externalShareEnabled == true)) && (resource.labels.contains("restricted"))) };

permit (principal is User, action == Action::"reviewLease", resource is Lease)
when { (((resource.monthlyRent >= 0) && (resource.squareFootage >= 0) && ((resource.termMonths >= 1) && (resource.termMonths <= 120))) && ((principal.roles.contains(Role::"Broker") || principal.roles.contains(Role::"TransactionCoordinator"))) && (!(((resource.squareFootage > 20000))) || (principal != resource.listingAgent)) && (resource.segment.contains("high_value")) && (!(resource.contingencies.contains("title_clearance")) || context.contingencyReviewCompleted) && (!((resource.monthlyRent > 1000000)) || (principal.roles.contains(Role::"Broker")))) };

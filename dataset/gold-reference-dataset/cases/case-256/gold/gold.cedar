permit (principal is User, action == Action::"moderate", resource is Content)
when { (true && ((principal.roles.contains(Role::"Moderator"))) && (!(true) || (resource.status == ContentStatusValue::"flagged")) && (((context.moderateScheduledStart <= context.currentTime) && (context.currentTime < context.moderateScheduledEnd))) && (resource.labels.contains("review_required")) && (context.deviceTrusted)) };

permit (principal is User, action == Action::"enterCage", resource is Cage)
when { ((((principal.clearanceLevel == 0) || (principal.clearanceLevel == 1) || (principal.clearanceLevel == 2)) && ((resource.zoneClearance == 0) || (resource.zoneClearance == 1) || (resource.zoneClearance == 2))) && ((principal.roles.contains(Role::"FacilityTech") || principal.roles.contains(Role::"TenantEngineer") || principal.roles.contains(Role::"Escort"))) && (!(true) || (resource.status == CageStatusValue::"active") || ((context.maintenanceWindow && (principal.roles.contains(Role::"FacilityTech"))) && (resource.status == CageStatusValue::"locked"))) && (((principal.badge.holder == principal) && (context.currentTime < principal.badge.expiresAt))) && ((principal.memberOf in resource.siteZone))) };

permit (principal is User, action == Action::"viewApplication", resource is Application)
when { ((((principal.piiClearance == 0) || (principal.piiClearance == 1) || (principal.piiClearance == 2)) && ((resource.piiSensitivity == 0) || (resource.piiSensitivity == 1) || (resource.piiSensitivity == 2))) && ((principal.roles.contains(Role::"Recruiter") || principal.roles.contains(Role::"HiringManager") || principal.roles.contains(Role::"Interviewer") || principal.roles.contains(Role::"Coordinator"))) && (!(true) || (principal.piiClearance >= resource.piiSensitivity) || (context.execApproval && (principal.roles.contains(Role::"Recruiter") || principal.roles.contains(Role::"HiringManager") || principal.roles.contains(Role::"Interviewer") || principal.roles.contains(Role::"Coordinator")))) && (((("screening" == "received") && (resource.status == ApplicationStatusValue::"received")) || (("screening" == "screening") && (resource.status == ApplicationStatusValue::"screening")) || (("screening" == "interviewing") && (resource.status == ApplicationStatusValue::"interviewing")) || (("screening" == "offer") && (resource.status == ApplicationStatusValue::"offer")) || (("screening" == "closed") && (resource.status == ApplicationStatusValue::"closed")))) && ((resource.reqCode like "ENG-*")) && (context.onCorpNetwork)) };

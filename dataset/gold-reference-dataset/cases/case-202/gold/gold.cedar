permit (principal is User, action == Action::"signoffWorkOrder", resource is WorkOrder)
when { ((((resource.defectCount >= 0) && (resource.defectCount <= 100))) && ((principal.roles.contains(Role::"Inspector") || principal.roles.contains(Role::"QualityManager"))) && (!(true) || (principal != resource.operator) || (context.deviationAuthorized && (principal.roles.contains(Role::"QualityManager")))) && (((context.signoffWorkOrderScheduledStart <= context.currentTime) && (context.currentTime < context.signoffWorkOrderScheduledEnd))) && ((resource.partCode like "CONTROLLED-*")) && ((resource.defectCount <= 1))) };

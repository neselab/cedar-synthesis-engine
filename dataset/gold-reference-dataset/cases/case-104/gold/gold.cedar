permit (principal is User, action == Action::"acknowledgeCritical", resource is LabResult)
when { (true && ((principal.roles.contains(Role::"OrderingProvider"))) && (!(true) || (principal == resource.orderingProvider) || (context.coverageAuthorized && (principal.roles.contains(Role::"OrderingProvider")))) && ((((((context.currentTime < datetime("1970-01-01T00:00:00Z")) && (resource.criticalNotifiedAt < datetime("1970-01-01T00:00:00Z"))) || ((datetime("1970-01-01T00:00:00Z") <= context.currentTime) && (datetime("1970-01-01T00:00:00Z") <= resource.criticalNotifiedAt))) && (resource.criticalNotifiedAt <= context.currentTime) && (context.currentTime.durationSince(resource.criticalNotifiedAt).toMilliseconds() <= 900000)) || ((resource.criticalNotifiedAt < datetime("1970-01-01T00:00:00Z")) && (datetime("1969-12-31T23:00:00Z") <= resource.criticalNotifiedAt) && (datetime("1970-01-01T00:00:00Z") <= context.currentTime) && (context.currentTime.durationSince(datetime("1970-01-01T00:00:00Z")).toMilliseconds() <= 900000) && (context.currentTime.durationSince(datetime("1970-01-01T00:00:00Z")).toMilliseconds() <= (900000 - datetime("1970-01-01T00:00:00Z").durationSince(resource.criticalNotifiedAt).toMilliseconds())))))) };

permit (principal is User, action == Action::"releaseResult", resource is LabResult)
when { ((((resource.sensitivity == 0) || (resource.sensitivity == 1) || (resource.sensitivity == 2))) && ((principal.roles.contains(Role::"Pathologist") || principal.roles.contains(Role::"OrderingProvider")) || ((context.emergencyRelease && (principal.roles.contains(Role::"MedicalTechnologist"))) && (principal == resource.verifiedBy))) && (!(true) || (principal != resource.verifiedBy) || ((context.emergencyRelease && (principal.roles.contains(Role::"MedicalTechnologist"))) && (principal == resource.verifiedBy))) && (!((resource.criticalFlag == true)) || context.criticalReleaseReviewCompleted)) };

permit (principal is User, action == Action::"releaseToPortal", resource is LabResult)
when { ((((principal.credentialLevel == 0) || (principal.credentialLevel == 1) || (principal.credentialLevel == 2)) && ((resource.sensitivity == 0) || (resource.sensitivity == 1) || (resource.sensitivity == 2))) && ((principal.roles.contains(Role::"Pathologist") || principal.roles.contains(Role::"LabDirector"))) && (!(true) || (resource.status == LabResultStatusValue::"released"))) };

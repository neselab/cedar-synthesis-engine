permit (principal is User, action == Action::"approvePayout", resource is Payout)
when { ((((resource.account.kycTier == 0) || (resource.account.kycTier == 1) || (resource.account.kycTier == 2) || (resource.account.kycTier == 3)) && (resource.amount >= 0)) && ((principal.roles.contains(Role::"FinanceApprover"))) && (!(((resource.amount > 50000))) || (principal != resource.initiatedBy) || (context.emergencyDeclared && (principal.roles.contains(Role::"FinanceApprover"))))) };

permit (principal is User, action == Action::"disbursePayout", resource is Payout)
when { ((((resource.account.kycTier == 0) || (resource.account.kycTier == 1) || (resource.account.kycTier == 2) || (resource.account.kycTier == 3)) && (resource.amount >= 0)) && ((principal.roles.contains(Role::"PayoutAgent"))) && (!(true) || (principal == resource.initiatedBy)) && (!(true) || (resource.account.fraudStatus == SellerAccountFraudStatusValue::"clear")) && (!((resource.amount > 500000)) || context.disbursePayoutV8ReviewCompleted)) };

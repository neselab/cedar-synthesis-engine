permit (principal is User, action == Action::"reviewCreative", resource is Creative)
when { ((((principal.reviewerLevel == 0) || (principal.reviewerLevel == 1) || (principal.reviewerLevel == 2)) && ((resource.riskRating == 0) || (resource.riskRating == 1) || (resource.riskRating == 2))) && ((principal.roles.contains(Role::"BrandSafetyReviewer"))) && (!(true) || (principal != resource.submittedBy)) && (!(true) || (principal.reviewerLevel >= resource.riskRating)) && (((("pending" == "pending") && (resource.status == CreativeStatusValue::"pending")) || (("pending" == "approved") && (resource.status == CreativeStatusValue::"approved")) || (("pending" == "rejected") && (resource.status == CreativeStatusValue::"rejected")))) && (resource.contentTags.contains("advertising")) && (context.mfaUsed)) };

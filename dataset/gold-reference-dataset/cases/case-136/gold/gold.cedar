permit (principal is User, action == Action::"postAdjustment", resource is Folio)
when { ((((principal.adjustmentAuthorityLevel == 0) || (principal.adjustmentAuthorityLevel == 1) || (principal.adjustmentAuthorityLevel == 2) || (principal.adjustmentAuthorityLevel == 3)) && (resource.adjustmentAmount >= 0) && ((resource.guestSegment == 0) || (resource.guestSegment == 1) || (resource.guestSegment == 2) || (resource.guestSegment == 3)) && (resource.originalCharge >= 0)) && ((principal.roles.contains(Role::"FrontDeskAgent") || principal.roles.contains(Role::"NightAuditor"))) && (!(((resource.adjustmentAmount > 2500))) || (principal.adjustmentAuthorityLevel >= resource.guestSegment)) && (!((resource.vipFlag == true)) || context.vipHandlingReviewed) && (resource.charges.contains("DISPUTED-001")) && (context.onPropertyNetwork)) };

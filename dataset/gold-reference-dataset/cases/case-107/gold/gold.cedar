permit (principal is User, action == Action::"reviewLease", resource is Lease)
when { (((resource.monthlyRent >= 0) && (resource.squareFootage >= 0) && ((resource.termMonths >= 1) && (resource.termMonths <= 120))) && ((principal.roles.contains(Role::"Broker") || principal.roles.contains(Role::"TransactionCoordinator"))) && (!(true) || (resource.status == LeaseStatusValue::"drafted")) && ((context.currentTime < resource.signWindowEnd)) && (context.identityVerified) && ((resource.leaseCode like "CONTROLLED-*")) && (context.onBrokerageNetwork)) };

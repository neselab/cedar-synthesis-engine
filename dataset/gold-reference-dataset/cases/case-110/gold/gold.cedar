permit (principal is User, action == Action::"approveChange", resource is ChangeRequest)
when { ((((principal.authorityLevel == 0) || (principal.authorityLevel == 1) || (principal.authorityLevel == 2) || (principal.authorityLevel == 3)) && (resource.affectedNodeCount >= 0) && ((resource.changeRisk == 0) || (resource.changeRisk == 1) || (resource.changeRisk == 2) || (resource.changeRisk == 3)) && (resource.estimatedCost >= 0) && (resource.rollbackStepCount >= 0)) && ((principal.roles.contains(Role::"ChangeManager") || principal.roles.contains(Role::"CABApprover"))) && (!(true) || (principal.authorityLevel >= resource.changeRisk)) && ((resource.emergencyChange == true)) && (resource.changeCategory.contains("transport")) && ((principal.roles.contains(Role::"CABApprover"))) && ((resource.changeCode like "CORE-*"))) };

permit (principal is User, action == Action::"readDocument", resource is Document)
when { ((((principal.clearance == 0) || (principal.clearance == 1) || (principal.clearance == 2) || (principal.clearance == 3)) && ((resource.classification == 0) || (resource.classification == 1) || (resource.classification == 2) || (resource.classification == 3))) && ((principal.roles.contains(Role::"Analyst") || principal.roles.contains(Role::"Officer"))) && (!(true) || (principal.clearance >= resource.classification)) && (resource.compartments.contains("BRAVO")) && (principal.compartments.containsAll(resource.compartments)) && (context.onIntranet)) };

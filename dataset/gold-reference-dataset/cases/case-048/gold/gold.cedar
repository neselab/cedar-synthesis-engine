permit (principal is User, action == Action::"issueRefund", resource is Refund)
when { (((resource.amount >= 0) && (resource.order.itemTotal >= 0) && ((resource.order.loyaltyTier == 0) || (resource.order.loyaltyTier == 1) || (resource.order.loyaltyTier == 2)) && (resource.order.taxAmount >= 0)) && ((principal.roles.contains(Role::"ServiceRep") || principal.roles.contains(Role::"Manager"))) && (!((((resource.order.itemTotal > 50000) || (resource.order.taxAmount > (50000 - resource.order.itemTotal))))) || (principal != resource.order.placedBy)) && (context.mfaUsed) && ((resource.order.loyaltyTier >= 1)) && (context.inCardholderZone)) };

# Copy this file to config/jarvis.env. These defaults reproduce the documented
# Stevens Jarvis L40S setup. Never add passwords, cloud API keys, or Hugging
# Face tokens to this file.

# Jarvis defaults. The working examples did not include --account or --qos, so
# "none" tells these scripts to leave both options out.
JARVIS_GPU_PARTITION="gpu-l40s"
JARVIS_CPU_PARTITION="compute"
JARVIS_SLURM_ACCOUNT="none"
JARVIS_SLURM_QOS="none"

# CUDA/cuDNN module used by the documented Jarvis setup.
JARVIS_CUDA_MODULE="cudnn9.1-cuda12.2/9.1.1.17"

# Recommended one-L40S model profile.
AUTOCEDAR_MODEL_REPO="Qwen/Qwen3.6-27B-FP8"
AUTOCEDAR_MODEL_NAME="autocedar-local"
AUTOCEDAR_MODEL_REVISION="none" # Optional Hugging Face commit/tag; "none" uses the repository default.
AUTOCEDAR_MODEL_CACHE="${SCRATCH:-$HOME/.cache}/autocedar/models"
AUTOCEDAR_HF_HOME="$HOME/.config/autocedar/huggingface" # Private token/config directory, not the weight cache.

# GPU job resources for the recommended model. MEMORY is ordinary computer
# memory requested from Slurm; it is not the GPU's own memory.
JARVIS_GPU_COUNT="1"
JARVIS_GPU_CPUS="2"
JARVIS_GPU_MEMORY="64G"
JARVIS_GPU_TIME="04:00:00"

# CPU job resources used only for the one-time Cedar/CVC5 installation.
JARVIS_CPU_CPUS="4"
JARVIS_CPU_MEMORY="16G"
JARVIS_CPU_TIME="02:00:00"

# Local vLLM environment and server tuning. Change these only with guidance.
AUTOCEDAR_VLLM_ENV="$HOME/.venvs/autocedar-vllm"
# Preferred port. The launcher automatically chooses another free port when
# this port is already occupied by a different job on the shared GPU node.
AUTOCEDAR_MODEL_PORT="8000"
AUTOCEDAR_MAX_MODEL_LEN="32768"
# Maximum simultaneous sequences, not the length of a sequence. AutoCedar's
# single-user workflow needs far fewer than this.
AUTOCEDAR_MAX_NUM_SEQS="128"
AUTOCEDAR_GPU_MEMORY_UTILIZATION="0.90"
AUTOCEDAR_STARTUP_TIMEOUT_SECONDS="900"

# Qwen3.6-specific vLLM switches. Read the README before changing the model.
AUTOCEDAR_VLLM_LANGUAGE_MODEL_ONLY="true"
AUTOCEDAR_VLLM_REASONING_PARSER="qwen3"
AUTOCEDAR_VLLM_ENABLE_THINKING="false"

# AutoCedar local-provider request limits.
AUTOCEDAR_LOCAL_MAX_TOKENS="8192"
AUTOCEDAR_LOCAL_TIMEOUT_SECONDS="600"
AUTOCEDAR_LOCAL_STRUCTURED_OUTPUT="auto"

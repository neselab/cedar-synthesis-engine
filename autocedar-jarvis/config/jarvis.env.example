# Copy this file to config/jarvis.env, then replace every REPLACE_WITH_ value.
# Ask the Stevens lab administrator for these values. Never add passwords,
# cloud API keys, or Hugging Face tokens to this file.

# Required Slurm values.
JARVIS_GPU_PARTITION="REPLACE_WITH_GPU_PARTITION"
JARVIS_CPU_PARTITION="REPLACE_WITH_CPU_PARTITION"
JARVIS_SLURM_ACCOUNT="REPLACE_WITH_SLURM_ACCOUNT_OR_none"
JARVIS_SLURM_QOS="none" # Replace only if the administrator gives you a QOS.

# Current CUDA/cuDNN environment module. Use "none" only if the administrator
# confirms that no module is required.
JARVIS_CUDA_MODULE="REPLACE_WITH_CUDA_OR_CUDNN_MODULE"

# Lab-approved model. This may be a Hugging Face repository such as
# organization/model-name or an absolute shared filesystem path.
AUTOCEDAR_MODEL_REPO="REPLACE_WITH_APPROVED_MODEL_REPO_OR_PATH"
AUTOCEDAR_MODEL_NAME="autocedar-local"
AUTOCEDAR_MODEL_REVISION="none" # Optional Hugging Face commit/tag; "none" uses the repository default.
AUTOCEDAR_MODEL_CACHE="REPLACE_WITH_ABSOLUTE_MODEL_CACHE_PATH"
AUTOCEDAR_HF_HOME="$HOME/.config/autocedar/huggingface" # Private token/config directory, not the weight cache.

# GPU job resources. Confirm these values for the selected model. MEMORY is
# host RAM requested through Slurm --mem; it is not GPU VRAM.
JARVIS_GPU_COUNT="1"
JARVIS_GPU_CPUS="2"
JARVIS_GPU_MEMORY="64G"
JARVIS_GPU_TIME="04:00:00"

# CPU job resources used only for the one-time Cedar/CVC5 installation.
JARVIS_CPU_CPUS="4"
JARVIS_CPU_MEMORY="16G"
JARVIS_CPU_TIME="02:00:00"

# Local vLLM environment and server tuning. Change these only with guidance.
AUTOCEDAR_VLLM_ENV="$HOME/.venvs/autocedar-vllm"
AUTOCEDAR_MODEL_PORT="8000"
AUTOCEDAR_MAX_MODEL_LEN="32768"
AUTOCEDAR_GPU_MEMORY_UTILIZATION="0.90"
AUTOCEDAR_STARTUP_TIMEOUT_SECONDS="900"

# Model-specific vLLM switches. The README gives the exact Qwen3.6 values.
# For another model, keep these generic defaults unless the administrator says
# otherwise. No arbitrary vLLM argument string is accepted by the launcher.
AUTOCEDAR_VLLM_LANGUAGE_MODEL_ONLY="false"
AUTOCEDAR_VLLM_REASONING_PARSER="none"
AUTOCEDAR_VLLM_ENABLE_THINKING="default"

# AutoCedar local-provider request limits.
AUTOCEDAR_LOCAL_MAX_TOKENS="8192"
AUTOCEDAR_LOCAL_TIMEOUT_SECONDS="600"
AUTOCEDAR_LOCAL_STRUCTURED_OUTPUT="auto"

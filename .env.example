# AutoCedar environment template.
# Copy to `.env` and fill in. `.env` is gitignored.
#
# AutoCedar automatically loads the nearest `.env` from the current working
# directory or one of its parents. Real shell environment variables win over
# values in this file.

# Default live provider. Choices: codex, claude-cli, anthropic, openai, local.
# Codex OAuth is the default. Run `codex login` once.
AUTOCEDAR_PROVIDER=codex
AUTOCEDAR_CODEX_MODEL=gpt-5.5

# Optional Claude Code subscription path. Run `claude auth login` first.
# AUTOCEDAR_PROVIDER=claude-cli
# AUTOCEDAR_CLAUDE_CLI_MODEL=sonnet

# Optional direct Anthropic API path.
# ANTHROPIC_API_KEY=sk-ant-...
# AUTOCEDAR_ANTHROPIC_MODEL=claude-opus-4-7

# Optional direct OpenAI API path. This is distinct from Codex OAuth.
# AUTOCEDAR_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AUTOCEDAR_OPENAI_MODEL=gpt-5.6

# Optional local-model path (for example, vLLM on a GPU node).
# The model name must match the server's advertised/served model name.
# AUTOCEDAR_PROVIDER=local
# AUTOCEDAR_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# AUTOCEDAR_LOCAL_API_KEY=autocedar-local
# AUTOCEDAR_LOCAL_MODEL=autocedar-local
# Optional: default model and adaptive thinking effort for TUI chat,
# authoring atomization, and default TUI synthesis phase models.
# These can also be changed inside the interactive agent with /model and /effort.
# AUTOCEDAR_MODEL=gpt-5.5
# AUTOCEDAR_EFFORT=high

# Optional: external solver binary paths.
# Defaults are ~/.cargo/bin/cedar and ~/.local/bin/cvc5.
# CEDAR=/usr/local/bin/cedar
# CVC5=/usr/bin/cvc5

# Optional: root used by packaged v1 harness compatibility code.
# AUTOCEDAR_ROOT=/path/to/cedar-synthesis-engine

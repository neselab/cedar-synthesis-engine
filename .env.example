# AutoCedar environment template.
# Copy to `.env` and fill in. `.env` is gitignored.
#
# AutoCedar automatically loads the nearest `.env` from the current working
# directory or one of its parents. Real shell environment variables win over
# values in this file.

# Anthropic API key for TUI chat, schema/property atomization, and harness LLM calls.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model for the conversational TUI/chat layer.
# The authoring atomizers default to autocedar.llm.DEFAULT_MODEL unless a CLI
# --model flag is supplied.
# AUTOCEDAR_CHAT_MODEL=claude-opus-4-7

# Optional: external solver binary paths.
# Defaults are ~/.cargo/bin/cedar and ~/.local/bin/cvc5.
# CEDAR=/usr/local/bin/cedar
# CVC5=/usr/bin/cvc5

# Optional: root used by packaged v1 harness compatibility code.
# AUTOCEDAR_ROOT=/path/to/cedar-synthesis-engine

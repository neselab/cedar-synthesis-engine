permit (principal, action == Action::"addProviderToList", resource) when { context.session.isActive && resource.patient == principal && context.provider.name == context.searchName && context has searchSpecialty && context.provider has specialty && context.provider.specialty == context.searchSpecialty && (!(context has searchZipCode) || (context has searchZipCode && context.provider has zipCode && context.provider.zipCode == context.searchZipCode)) };
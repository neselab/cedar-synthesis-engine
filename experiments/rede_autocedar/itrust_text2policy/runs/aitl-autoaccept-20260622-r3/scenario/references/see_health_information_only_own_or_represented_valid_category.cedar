permit (principal, action == Action::"seeRecordHealthInformation", resource) when { resource is MedicalRecord && ((principal is Patient && resource.patient == principal) || (principal is PersonalRepresentative && principal in resource.patient.personalRepresentatives)) && ((context.informationCategory == "personalHealthInformation" && resource.hasPersonalHealthInformation) || (context.informationCategory == "immunizations" && resource.hasImmunizations) || (context.informationCategory == "officeVisitInformation" && resource.hasOfficeVisitInformation)) };
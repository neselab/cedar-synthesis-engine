permit (principal, action == Action::"takeOfficeVisitSurvey", resource) when { context.session.isActive && context.patient == resource.patient && !resource.surveyTaken && ((context.session has patientUser && context.session.patientUser == principal && resource.patient == principal) || (context.session has personalRepresentativeUser && context.session.personalRepresentativeUser == principal && principal.representedPatients.contains(resource.patient))) };
